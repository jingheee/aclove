{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/main.go"
    },
    {
      "name": "Debug Frontend (pnpm dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend/aclove",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (Go + Frontend)",
      "configurations": ["Debug Go Backend", "Debug Frontend (pnpm dev)"],
      "stopAll": true
    }
  ]
}
